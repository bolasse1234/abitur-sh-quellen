{
  "name": "abitur-sh-quellen",
  "version": "1.0.0",
  "private": true,
  "description": "Inoffizielle, quellenbelegte Zusammenstellung amtlicher Informationen zu Oberstufe und Abitur in Schleswig-Holstein – optimiert für Menschen und KI-Agenten.",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/build.mjs",
    "update": "node scripts/fetch.mjs && node scripts/build.mjs",
    "dev": "node scripts/build.mjs && npx wrangler dev",
    "deploy": "node scripts/build.mjs && npx wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "linkedom": "^0.18.5",
    "marked": "^14.1.4",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "playwright-core": "^1.48.2",
    "wrangler": "^4.166.0"
  }
}
